{
  "logging": {
    "level": "INFO",
    "file": "logs/app.log"
  },
  "hotkeys": {
    "toggle": "CTRL+ALT+F8",
    "close": "CTRL+ALT+F9"
  },
  "overlay": {
    "click_through": true,
    "background_dimming": 0.55,
    "padding_px": 10,
    "base_font_size": 22,
    "min_font_size": 12,
    "max_width_px": 1600,
    "max_height_px": 900
  },
  "capture": {
    "backend_order": ["mss", "dxcam"],
    "black_threshold_mean": 8.0,
    "black_threshold_nonzero_ratio": 0.02
  },
  "ocr": {
    "lang": "eng",
    "psm": 6,
    "oem": 1,
    "scale_factor": 3,
    "threshold_mode": "otsu",
    "try_shadow_removal": true,
    "whitelist": "",
    "min_text_length": 3,
    "tessdata_dir": ""
  },
  "translation": {
    "provider": "libre",
    "libre": {
      "url": "http://127.0.0.1:5000/translate",
      "api_key_env": "LIBRETRANSLATE_API_KEY",
      "timeout_sec": 20
    }
  }
}

